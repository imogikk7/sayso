# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Baseten — Muse Spark Open (hackathon model name is fixed)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API — Muse Spark (vision for screenshots, style card, baseline). Standard tier only, NOT contributor.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Modal — training and serving (configured via `modal setup`, token stored by the CLI)
# SaySo backend (the deployed Modal URLs; eval/smoke_api.py, eval/blind_test.py and ios/scripts/gen_secrets.sh read them)
SAYSO_API_TOKEN=
SAYSO_API_URL=
SAYSO_GLIMMER_URL=
GLIMMER_KEY=

# Fireworks — optional: serving/fireworks.py and training/fireworks_sft.py (uploads were disabled during the hackathon)
FIREWORKS_API_KEY=
